%%machine bin;

%%access       bin_;
%%variable cs  bin_cs;
%%variable eof bin_eof;
%%variable ts  bin_ts;
%%variable te  bin_te;

%%write data;

static int   bin_cs  = 0;
static int   bin_act = 0;
static char* bin_eof = nullptr;
static char* bin_ts  = nullptr;
static char* bin_te  = nullptr;

static int ret = 0;

int bin(char *p, char *pe) {
    ret = 0;
    %%write init;
    %%write exec;
    return ret;
}

%%{
    plus  = '+';
    minus = '-';

    main := |*
        plus  => { ret = +ret; } ;
        minus => { ret = -ret; } ;
    *|;
}%%
